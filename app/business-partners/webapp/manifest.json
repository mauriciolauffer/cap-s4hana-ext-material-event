{
  "sap.app": {
    "id": "cap.s4hana.ext.businesspartners",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "${version}"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "business-partners/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://customer",
      "favIcon": "",
      "phone": "sap-icon://customer",
      "phone@2": "sap-icon://customer",
      "tablet": "sap-icon://customer",
      "tablet@2": "sap-icon://customer"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cap.s4hana.ext.businesspartners.i18n.i18n",
          "supportedLocales": ["en", ""],
          "fallbackLocale": "",
          "async": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": ["en", ""],
          "fallbackLocale": "",
          "async": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BusinessPartnersList",
          "target": "BusinessPartnersList"
        },
        {
          "pattern": "BusinessPartners({key}):?query:",
          "name": "BusinessPartnersObjectPage",
          "target": "BusinessPartnersObjectPage"
        }
      ],
      "targets": {
        "BusinessPartnersList": {
          "type": "Component",
          "id": "BusinessPartnersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BusinessPartners",
              "variantManagement": "Page",
              "navigation": {
                "BusinessPartners": {
                  "detail": {
                    "route": "BusinessPartnersObjectPage"
                  }
                }
              }
            }
          }
        },
        "BusinessPartnersObjectPage": {
          "type": "Component",
          "id": "BusinessPartnersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/BusinessPartners"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "caps4hanaextmaterialevent"
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "type": "List Report & Object Page"
  },
  "_version": "1.21.0"
}
